#For loop

people = ['osama','noor','ali','ahmad']

for person in people :
    if person == 'ali' :
       continue
    print(f'Current person : {person}')

for i in range (len(people)) :
    print(people[i])

for i in range(1,11) :         # print frpm 1 to 10 (the program will not print 11)
    print(f'Number : {i}')
 


